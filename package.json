{
  "name": "ffftv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "node --env-file=.env.local scripts/smoke.mjs",
    "format": "prettier --write src tests scripts next.config.ts package.json tsconfig.json README.md compose.yaml",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "hls.js": "1.7.4",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
